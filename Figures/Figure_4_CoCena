### 4.8.1. age_sex - interaction
```{r}


# metadata
meta <- gfc.ind_melt %>%
  select(PID, sex, age_cat) %>%
  distinct()

stopifnot(!anyDuplicated(meta$PID))

meta <- meta %>%
  mutate(
    sex = factor(sex, levels = c("Male", "Female")),
    age_cat = factor(age_cat, levels = c("_30", "_30_45", "_45")),
    age_sex = paste0(age_cat, "_", sex),
    age_sex = factor(
      age_sex,
      levels = c(
        "_30_Male", "_30_45_Male", "_45_Male",
        "_30_Female", "_30_45_Female", "_45_Female"
      )
    )
  ) %>%
  column_to_rownames("PID")

# expression matrix: rows = clusters, columns = PIDs
expr <- gfc.ind_melt %>%
  select(PID, cluster, value) %>%
  group_by(cluster, PID) %>%
  summarise(value = mean(value, na.rm = TRUE), .groups = "drop") %>%
  pivot_wider(names_from = PID, values_from = value) %>%
  column_to_rownames("cluster") %>%
  as.matrix()

# match metadata to expression columns
meta <- meta[colnames(expr), ]
stopifnot(all(rownames(meta) == colnames(expr)))


```
```{r}
